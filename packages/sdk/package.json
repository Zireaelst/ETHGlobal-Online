{
  "name": "@blockterms/sdk",
  "version": "0.1.0",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./local": { "types": "./dist/local.d.ts", "import": "./dist/local.js" }
  },
  "scripts": {
    "build": "tsup src/index.ts src/local.ts --format esm --clean && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blockterms/contracts": "workspace:*",
    "@blockterms/core": "workspace:*",
    "@blockterms/integrations": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
